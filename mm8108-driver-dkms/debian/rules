#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

VERSION := $(shell dpkg-parsechangelog -SVersion | sed 's/-[^-]*$$//')
UPSTREAM_GIT = https://github.com/MorseMicro/morse_driver.git
# Git tag: upstream tags the MM6108 and MM8108 series separately, and this
# package tracks the MM8108 series (see debian/watch).
UPSTREAM_TAG = mm8108-$(VERSION)
ORIG_TARBALL = ../mm8108-driver_$(VERSION).orig.tar.gz

%:
	dh $@ --with dkms

override_dh_auto_configure:

override_dh_auto_build:

override_dh_auto_test:

override_dh_auto_install:
	install -d debian/mm8108-driver-dkms/usr/src/mm8108-driver-$(VERSION)
	cp -a Makefile Kconfig *.c *.h LICENSE \
		debian/mm8108-driver-dkms/usr/src/mm8108-driver-$(VERSION)/
	cp -a dot11ah debian/mm8108-driver-dkms/usr/src/mm8108-driver-$(VERSION)/
	cp -a mmrc debian/mm8108-driver-dkms/usr/src/mm8108-driver-$(VERSION)/
	cp -a mmrc-submodule debian/mm8108-driver-dkms/usr/src/mm8108-driver-$(VERSION)/
	echo 'ccflags-y += -Wno-error' >> debian/mm8108-driver-dkms/usr/src/mm8108-driver-$(VERSION)/Makefile

override_dh_installudev:
	dh_installudev --name=morse-nm-unmanaged --priority=90

override_dh_auto_clean:

get-orig-source:
	rm -rf ../mm8108-driver-$(VERSION)
	git clone --depth=1 --branch $(UPSTREAM_TAG) --recurse-submodules \
		$(UPSTREAM_GIT) ../mm8108-driver-$(VERSION)
	tar czf $(ORIG_TARBALL) \
		--exclude='.git*' \
		-C .. mm8108-driver-$(VERSION)
	rm -rf ../mm8108-driver-$(VERSION)
	@echo "Created $(ORIG_TARBALL)"
