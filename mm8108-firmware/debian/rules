#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

VERSION := $(shell dpkg-parsechangelog -SVersion | sed 's/-[^-]*$$//')
# UPSTREAM_TAG = mm8108-$(VERSION)
# MorseMicro tagged the 2.0.x firmware release but never pushed the 2.1.x
# tags. Pin to the "Firmware binaries for Release 2.1" commit (head of the
# upstream 2.1 branch) for now.
UPSTREAM_COMMIT = ce39cefb5fd01ad689a0c0b043557d9c2a3167d8
ORIG_TARBALL = ../mm8108-firmware_$(VERSION).orig.tar.gz

%:
	dh $@

override_dh_auto_build:
	# Firmware is precompiled binary; nothing to build

override_dh_auto_install:
	$(MAKE) install TARGET_DIR=$(CURDIR)/debian/mm8108-firmware/lib/firmware/morse

override_dh_auto_clean:

get-orig-source:
	wget -O $(ORIG_TARBALL) \
		https://github.com/MorseMicro/morse-firmware/archive/$(UPSTREAM_COMMIT).tar.gz
	@echo "Created $(ORIG_TARBALL)"
