version=4

# Upstream is Morse Micro's morse_driver, which tags the MM6108 and MM8108
# series separately (e.g. mm6108-2.1.1). This package tracks the MM6108
# series; the Debian upstream version is the tag with the 'mm6108-' prefix
# stripped.

opts="filenamemangle=s%(?:.*?)?mm6108-@ANY_VERSION@@ARCHIVE_EXT@%mm6108-driver-$1.tar.gz%" \
  https://github.com/MorseMicro/morse_driver/tags \
  (?:.*?/)?mm6108-@ANY_VERSION@@ARCHIVE_EXT@
