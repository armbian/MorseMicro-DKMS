version=4

# Upstream tags the MM6108 and MM8108 series separately (e.g. mm8108-2.1.0).
# This package tracks the MM8108 series; the Debian upstream version is the
# tag with the 'mm8108-' prefix stripped.

opts="filenamemangle=s%(?:.*?)?mm8108-@ANY_VERSION@@ARCHIVE_EXT@%hostap-s1g-$1.tar.gz%" \
  https://github.com/MorseMicro/hostap/tags \
  (?:.*?/)?mm8108-@ANY_VERSION@@ARCHIVE_EXT@
