#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

VERSION := $(shell dpkg-parsechangelog -SVersion | sed 's/-[^-]*$$//')
# Git tag: upstream tags the MM6108 and MM8108 series separately, and this
# package tracks the MM8108 series (see debian/watch).
UPSTREAM_TAG = mm8108-$(VERSION)
ORIG_TARBALL = ../hostap-s1g_$(VERSION).orig.tar.gz

%:
	dh $@

override_dh_auto_configure:
	# Generate hostapd build configuration
	cp hostapd/defconfig hostapd/.config
	echo "CONFIG_IEEE80211AH=y" >> hostapd/.config

	# Generate wpa_supplicant build configuration
	cp wpa_supplicant/defconfig wpa_supplicant/.config
	echo "CONFIG_MESH=y" >> wpa_supplicant/.config
	echo "CONFIG_EAP_PEAP=y" >> wpa_supplicant/.config
	echo "CONFIG_EAP_MD5=y" >> wpa_supplicant/.config
	echo "CONFIG_EAP_MSCHAPV2=y" >> wpa_supplicant/.config
	echo "CONFIG_EAP_TLS=y" >> wpa_supplicant/.config
	echo "CONFIG_EAP_TLSV1_3=y" >> wpa_supplicant/.config
	echo "CONFIG_EAP_TTLS=y" >> wpa_supplicant/.config
	echo "CONFIG_EAP_GTC=y" >> wpa_supplicant/.config
	echo "CONFIG_EAP_PWD=y" >> wpa_supplicant/.config

override_dh_auto_build:
	$(MAKE) -C hostapd V=1 EXTRA_CFLAGS="-Wno-error=deprecated-declarations"
	$(MAKE) -C wpa_supplicant V=1 EXTRA_CFLAGS="-Wno-error=deprecated-declarations"

	# Rename manpages to match S1G binary names
	cp hostapd/hostapd.8 hostapd/hostapd_s1g.8
	cp hostapd/hostapd_cli.1 hostapd/hostapd_cli_s1g.1

override_dh_auto_install:
	# Binaries are installed from debian/*.install; upstream's 'make install'
	# would additionally install unwanted files, so the step is disabled.

override_dh_auto_test:
	# No test suite available

# wpa-supplicant-s1g.service is a bare daemon with a global control socket and
# no interfaces attached; it is only useful once the admin adds one. Install it
# but leave enabling it to them. The per-interface template unit
# (wpa-supplicant-s1g@<iface>.service) is the normal way to bring up a link.
override_dh_installsystemd:
	dh_installsystemd -phostapd-s1g
	dh_installsystemd -pwpa-supplicant-s1g --no-enable --no-start

override_dh_auto_clean:
	[ ! -f hostapd/.config ] || $(MAKE) -C hostapd clean
	[ ! -f wpa_supplicant/.config ] || $(MAKE) -C wpa_supplicant clean
	rm -f hostapd/.config wpa_supplicant/.config
	rm -f hostapd/hostapd_s1g.8 hostapd/hostapd_cli_s1g.1

get-orig-source:
	wget -O $(ORIG_TARBALL) \
		https://github.com/MorseMicro/hostap/archive/$(UPSTREAM_TAG).tar.gz
	@echo "Created $(ORIG_TARBALL)"
